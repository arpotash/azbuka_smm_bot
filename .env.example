# --- Telegram ---
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# id канала, бот должен быть его администратором с правом публикации
CHANNEL_ID=-1001234567890
# необязательно: публичный username канала для красивых ссылок «Опубликовано»
CHANNEL_USERNAME=
# user_id менеджеров через запятую. Узнать: @userinfobot
MANAGER_IDS=111111111,222222222
# кто может /new и /llmtest; пусто = все менеджеры
ADMIN_IDS=111111111

# --- Расписание и темы ---
TIMEZONE=Europe/Moscow
# день время тема; темы: promo (поставки и акции), product (товар), news (новости), free (без темы)
SCHEDULE_PLAN=mon 12:00 promo; wed 12:00 product; fri 12:00 news
# создать слот при старте, если процесс был выключен в момент cron
CATCH_UP_ON_START=true
# пауза после последнего сообщения перед отправкой в модель (склейка альбомов), сек
DEBOUNCE_SEC=1.5

# --- Подсказки с сайта и новости ---
SITE_API_URL=https://as-lesa.ru/api
# RSS/Atom-ленты для пятничных новостей, через запятую. Пусто = только статьи блога сайта
NEWS_FEEDS=
# новости старше N дней не предлагаются
NEWS_MAX_AGE_DAYS=14
# сколько вариантов показывать в напоминании
SUGGEST_COUNT=3
# защита от повторов: выбранный товар не предлагается N дней, показанный и не выбранный — M дней,
# категория выбранного товара — K дней
SUGGEST_PRODUCT_REPEAT_DAYS=180
SUGGEST_SHOWN_REPEAT_DAYS=30
SUGGEST_CATEGORY_REPEAT_DAYS=45

# --- Модель ---
# anthropic | fake (fake читает ответ из LLM_FAKE_REPLY_FILE, для проверки бота без API)
LLM_PROVIDER=anthropic
LLM_FAKE_REPLY_FILE=
ANTHROPIC_API_KEY=sk-ant-...
# адрес прокси или провайдера с совместимым Messages API; пусто = api.anthropic.com
# OpenRouter: ANTHROPIC_BASE_URL=https://openrouter.ai/api и ANTHROPIC_MODEL=anthropic/claude-opus-5
ANTHROPIC_BASE_URL=
# напрямую: claude-opus-5; через OpenRouter: anthropic/claude-opus-5
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max; пусто = не отправлять параметр (безопасно для прокси)
LLM_EFFORT=
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
# cache_control на системном промпте; выключите, если прокси его отклоняет
LLM_PROMPT_CACHE=true
# серверный фолбэк при отказе модели (beta server-side-fallback); выключено для совместимости с прокси
LLM_SERVER_FALLBACK=false
# сколько ошибок модели подряд по одному посту, прежде чем уведомить админов
LLM_ERROR_ALERT_THRESHOLD=3
# сколько последних постов передавать модели, чтобы не повторяться
LAST_POSTS_N=10

# --- Пути ---
DATA_DIR=./data
PROMPT_PATH=prompts/system.md
SITE_URL=https://as-lesa.ru
LOG_LEVEL=INFO
